from models.student import Student
from models.course import Course
from models.instructor import Instructor
from utils.file_handler import save_students, load_students


class EnrollmentManager:
    """
    Controls the whole university system logic.
    """

    def __init__(self):
        self.students = []
        self.courses = []
        self.instructors = []

        loaded_students = load_students()

        for s in loaded_students:
            self.students.append(s)

    # Method 1
    def add_student(self, student):
        self.students.append(student)

    # Method 2
    def add_course(self, course):
        self.courses.append(course)

    # Method 3
    def add_instructor(self, instructor):
        self.instructors.append(instructor)

    # Method 4
    def enroll_student_in_course(self, student_id, course_id):
        student = None
        course = None

        for s in self.students:
            if s.student_id == student_id:
                student = s

        for c in self.courses:
            if c.course_id == course_id:
                course = c

        if student and course:
            student.enroll_course(course.title)
            course.add_student(student.name)
            return "Enrollment successful"
        else:
            return "Student or Course not found"

    # Extra helper (useful for menu later)
    def list_students(self):
        return [s.get_details() for s in self.students]

    def list_courses(self):
        return [c.get_course_info() for c in self.courses]
